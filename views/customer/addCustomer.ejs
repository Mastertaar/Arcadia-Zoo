<section class="dashboard" id="dashboard">

  <div class="d-flex justify-content-between flex-wrap flex-md nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">add a user</h1>
  
    <div class="btn-toolbar">
      <div class="btn-group me-2">
       <button class="btn btn-sm btn-outline-secondary">?</button>
      </div>
    </div>
  </div>


  <div class="col py-3">
    <div class="row">

      <div class="col">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb" >
            <li class="breadcrumb-item"><a href="/dashboard">dashboard</a></li>
            <li class="breadcrumb-item active">nouvel utilisateur</a></li>
          </ol>
        </nav>
      </div>

      <div class="col text-end fw-lighter">
        <b>userId</b>
      </div>

    </div>
  </div>

  <form action="add" onsubmit="return false;" method="post">

    <div class="row form-group mb-4">
      <div class="col">
        <label for="firstName">prénom</label>
        <input name="firstName" type="text" class="form-control" id="firstName" value="" placeholder="prénom" 
        required>
      </div>

      <div class="col">
        <label for="lastName">nom de famille</label>
        <input name="lastName" type="text" class="form-control" id="lastName" value="" placeholder="nom de famille" 
        required>
      </div>
    </div>

    <div class="row form-group mb-4">
      <div class="col">
        <label for="tel">téléphone</label>
        <input name="tel" type="text" class="form-control" id="tel" value="" placeholder="telephone" 
        >
      </div>

      <div class="col">
        <label for="email">email</label>
        <input name="email" type="text" class="form-control" id="email" value="" placeholder="email"
        required>
      </div>
    </div>

    <div class="row form-group mb-4">
      <div class="col">
        <label for="password">mot de passe</label>
        <input name="password" type="password" class="form-control" id="password" value="" placeholder="mot de passe" 
        required>
      </div>

      <div class="col">
        <label for="confirm_password">mot de passe</label>
        <input name="confirm_password" type="password" class="form-control" id="confirm_password" value="" placeholder="confirmer mot de passe"
        required>
      </div>
    </div>

    <div class="form-group mb-4">
      <button type="submit" class="btn btn-sm btn-outline-secondary">ajouter un utilisateur</button>
    </div>
      

  </form>

</section>